{
  "name": "buscador-de-cep",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "description": "Consulte endereços por CEP e descubra rotas urbanas, rodoviárias, voos e viagens de carro a partir da sua localização (estilo Moovit)",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "teste:planejador": "node scripts/teste-planejador.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.7"
  }
}